#: rust/crates/jmap-ui/src/send_later/schedule.rs:234
#, c-format
msgid "Today, %1$s"
msgstr "Heute, %1$s"

#. TRANSLATORS: %1$s is a time of day, e.g. "08:00".
#: rust/crates/jmap-ui/src/send_later/schedule.rs:238
#, c-format
msgid "Tomorrow, %1$s"
msgstr "Morgen, %1$s"

