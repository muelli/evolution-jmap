#
# Terminology choices aligned with Evolution and evolution-data-server:
# - account: Konto (e.g. JMAP-Konto)
# - address book: Adressbuch
# - calendar: Kalender
# - folder: Ordner
# - mailbox: Postfach (or Ordner depending on context)
# - drafts: Entwürfe
# - sent: Gesendet
# - inbox: Posteingang
# - vacation responder / autoresponder: Abwesenheitsnotiz
# - snooze: Schlummern
# - send later: Später senden
# - keyring: Schlüsselbund
# - access token: Zugriffstoken
# - authorization / credentials: Legitimation / Anmeldedaten
# - server: Server
# - host name: Servername
# - sender: Absender
# - recipient: Empfänger
# - GNOME German conventions: formal "Sie", typographic quotes »…«, ellipsis …
#
msgid ""
msgstr ""
"Project-Id-Version: evolution-jmap\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-10-06 04:04+0000\n"
"PO-Revision-Date: 2026-10-10 00:00+0000\n"
