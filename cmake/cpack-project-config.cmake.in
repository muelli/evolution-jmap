#
# CPACK_PROJECT_CONFIG_FILE: CPack includes this file once for each generator,
# in the `cpack` process, before it stages the install tree and writes the
# archive. Only here can the package timestamps be set. CPackConfig.cmake
# contains variables, but SOURCE_DATE_EPOCH must be an *environment* variable
# when CPack writes the archive.
#
# Reason: `cpack` installs again into a new staging tree. Without this file,
# the packaging clock dates the directory entries and the ar member headers,
# and the link times of the modules date the file entries. Two packages from
# one tree are then different. Users could not verify the `.deb` against a
# published digest, as this project asks for its artifacts.
#
# The value is the one this build resolved at configure time: the exported
# SOURCE_DATE_EPOCH, or else the timestamp of the last commit. Thus the
# package and its binaries have the same date. This file intentionally ignores
# a value exported when `cpack` runs. That value would let the packager
# change the date of a build that they did not make.
#
# Generated from cmake/cpack-project-config.cmake.in.
# Edit that file, not this one.

set(_epoch "@SOURCE_DATE_EPOCH@")
if(_epoch MATCHES "^[0-9]+$")
	set(ENV{SOURCE_DATE_EPOCH} "${_epoch}")
endif()
