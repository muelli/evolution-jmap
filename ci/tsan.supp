#
# ThreadSanitizer suppressions for ci/thread-check-eds.sh.
#
# Each entry is a race inside GLib, Camel, EDS or the C library, not in this
# project's code. Each entry has a one-line reason. Use race_top where you
# can: it matches only the top frame, so a race in our code below the same
# function still shows. Never suppress a frame of this project.

# GLib: G_DEFINE_QUARK reads its static quark with no lock. Every thread
# computes the same value.
race_top:_error_quark$
# The same race in a quark that the compiler inlined into these functions:
# CAMEL_STORE_ERROR, G_KEY_FILE_ERROR and E_CLIENT_ERROR.
race_top:^camel_store_get_folder_sync$
race_top:^g_key_file_get_value$
race_top:^e_client_error_create$

# GLib: g_once_impl writes the status with a plain store, and the g_once
# macro reads it atomically. The mutex in g_once_impl orders the real work.
race_top:^g_once_impl$

# GLib: a static GRWLock creates its pthread lock lazily with a
# compare-and-exchange, and the fast path reads the pointer with no barrier.
race_top:^g_rw_lock_reader_lock$

# GLib: a GClosure keeps its counters in bit fields. Writers change them with
# compare-and-exchange, readers read them with no barrier.
race_top:^g_closure_
race_top:^_g_closure_is_void$
race_top:^closure_invoke_notifiers$

# GLib: type_data_make_W sets a bit field of the type node under the type
# lock. g_type_is_a reads another bit of the same word with no lock. That bit
# does not change after the type is registered.
race_top:^type_data_make_W$

# GLib: g_object_base_class_init sets a bit in the flags of the parent class
# under the type lock. g_object_new_internal reads other bits of the same word
# with no lock. Those bits do not change after the parent class is made.
race_top:^g_object_base_class_init$

# GLib: GAtomicArray puts an old buffer on a free list under its lock, and a
# reader can still read it. The reader then sees a changed array pointer and
# reads again.
race_top:^freelist_free$

# GLib: g_private_get makes its pthread key lazily with a
# compare-and-exchange. When it loses the race, it reads the winner's key
# with a plain load.
race_top:^g_private_get$

# GLib: g_rec_mutex_lock makes the pthread lock of a static GRecMutex lazily
# with a compare-and-exchange. When it loses the race, it reads the winner's
# lock with a plain load.
race_top:^g_rec_mutex_lock$

# GLib: get_tmp_file increments a static counter with no lock. The counter
# only seeds the name, and a name that exists already gives a retry.
race_top:^get_tmp_file$

# GLib: timer_perturb is a lazy static. Every thread computes the same value.
race_top:^g_timeout_set_expiration$

# Camel: camel_db_release_cache_memory, inlined here, reads a lazy static
# from the environment. Every thread computes the same value.
race_top:^camel_db_create_folders_table$

# Camel: the pool pointer is read with no lock before the pool lock. A
# pooled string to free proves that the pool exists already.
race_top:^camel_pstring_free$

# Camel: the "loaded" flag has no lock. The tests call this from parallel
# threads. Evolution and EDS call it once, on one thread.
race_top:^camel_provider_init$

# EDS: e_get_user_config_dir and e_server_side_source_get_user_dir (inlined
# here) publish a lazy static string with no lock. The tests make sources on
# parallel threads. The registry service makes them on its main thread.
race:^e_get_user_config_dir$
race:^e_server_side_source_init$

# EDS: e_source_registry_debug_enabled (inlined into the print function)
# reads ESR_DEBUG into a lazy static with no lock. Every thread computes the
# same value.
race_top:^e_source_registry_debug_print$

# libical: loading a builtin zone frees and replaces its location under the
# builtin lock. This lookup reads every location with no lock. The race is
# real, and the master branch of libical has it too. Only libical can fix it.
race:^icaltimezone_get_builtin_timezone$

# libical-glib: the library is not instrumented, so ThreadSanitizer does not
# see the atomic g_once that publishes its type ids to g_object_new.
race:^i_cal_object_construct$

# glibc: mktime changes its time zone state under an internal lock that
# ThreadSanitizer cannot see.
race:^camel_mktime_utc$

# glibc: gmtime_r, called here, sets up its time zone state under the same
# internal lock as mktime.
race:^icaltime_from_timet_with_zone$
